    function H.refreshStickers(force)
        H.dedupStickers()
        local want, order = {}, {}
        for _, sticker in ipairs(MEME_STICKERS) do
            local key = (sticker.hash and sticker.hash~="" and sticker.hash) or sticker.id
            if key and not want[key] then
                want[key]=sticker
                order[#order+1]=key
            end
        end
        for key, btn in pairs(drawnStickerKeys) do
            if not want[key] then
                if btn.Parent then btn:Destroy() end
                drawnStickerKeys[key]=nil
            end
        end
        for i, key in ipairs(order) do
            if not drawnStickerKeys[key] then
                local btn = H.buildStickerButton(want[key])
                btn.LayoutOrder=i
                btn.Parent=stickerScroller
                drawnStickerKeys[key]=btn
                if i % UI_BUILD_YIELD_EVERY == 0 then task.wait() end
            end
        end
        stickerScroller.CanvasSize=UDim2.new(0,#order*96,0,0)
    end

