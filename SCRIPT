    -- ONLINE LIST REFRESH (forward decl)
    function H.refreshOnlineListCore()
        local resp=httpGetFresh(PRESENCE_URL)
        local data=jsonDecode(resp or "{}")
        if type(data)~="table" then return end
        for _,c in ipairs(onlineScroller:GetChildren()) do
            if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
        end
        local rows={}
        -- lastSeen is a Firebase SERVER timestamp: compare against the newest heartbeat, not the local clock
        local nowMs=tonumber(data._now) or 0
        if nowMs==0 then
            for _,e in pairs(data) do
                if type(e)=="table" then
                    local ls=tonumber(e.lastSeen) or 0
                    if ls>nowMs then nowMs=ls end
                end
            end
            if nowMs==0 then nowMs=os.time()*1000 end
        end
        local latestByUid={}
        for fbKey,entry in pairs(data) do
            if type(entry)=="table" and tonumber(entry.userId or fbKey) then
                local lastSeen=tonumber(entry.lastSeen) or 0
                local uid=tostring(entry.userId or fbKey)
                if nowMs-lastSeen<40000 then
                    local exist=latestByUid[uid]
                    if not exist or lastSeen>exist.lastSeen then
                        latestByUid[uid]={uid=uid, entry=entry, lastSeen=lastSeen}
                    end
                end
            end
        end
        for _,r in pairs(latestByUid) do table.insert(rows, r) end
        table.sort(rows, function(a,b) return (a.entry.displayName or a.entry.name or ""):lower()<(b.entry.displayName or b.entry.name or ""):lower() end)
        for idx,row in ipairs(rows) do
            local uid=row.uid
            local role=resolveRole(row.entry.role, uid)
            local displayName=getOnlineName(uid, row.entry)
            local holder=Instance.new("Frame")
            holder.Size=UDim2.new(1,0,0,40) holder.BackgroundColor3=PAL.PANEL_SOFT
            holder.BorderSizePixel=0 holder.LayoutOrder=idx holder.Parent=onlineScroller
            local hc=Instance.new("UICorner") hc.CornerRadius=UDim.new(0,6) hc.Parent=holder
            local av=Instance.new("ImageLabel")
            av.Size=UDim2.new(0,28,0,28) av.Position=UDim2.new(0,3,0,6)
            av.BackgroundTransparency=1 av.Image=H.avatarFallback(uid) av.Parent=holder
            H.loadAvatarInto(av, uid, row.entry.name or row.entry.displayName)
            local dot=Instance.new("Frame")
            dot.Size=UDim2.new(0,6,0,6) dot.Position=UDim2.new(0,28,0,28)
            dot.BackgroundColor3=Color3.fromRGB(38,235,92) dot.BorderSizePixel=1
            dot.BorderColor3=PAL.PANEL_SOFT dot.ZIndex=3 dot.Parent=holder
            local dotC=Instance.new("UICorner") dotC.CornerRadius=UDim.new(0.5,0) dotC.Parent=dot
            local nameLbl=Instance.new("TextLabel")
