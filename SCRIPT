    local musicFetchInProgress, lastMusicFetch=false, 0
    task.spawn(function()
        while alive do
            task.wait(MUSIC_POLL_INTERVAL)
            pcall(function()
                local nowClock=os.clock()
                if musicFetchInProgress or nowClock-lastMusicFetch<MUSIC_POLL_INTERVAL-1 then return end
                musicFetchInProgress=true lastMusicFetch=nowClock
                if not alive then return end
                local resp=httpGetFresh(MUSIC_PRESENCE_URL)
                if resp and resp~="null" and #resp>10 then
                    local data=jsonDecode(resp)
                    if type(data)=="table" and (data.assetId or data.musicAssetId) then
                        local ts=tonumber(data.timestamp) or 0
                        if ts==0 or ts>lastMusicTs or lastMusicTs==0 then
                            local action=data.musicAction or data.action or "play"
                            local assetId=data.musicAssetId or data.assetId or ""
                            if tonumber(data.byUserId)~=player.UserId then
                                if action=="stop" or assetId=="" then
                                    if currentSound or isServerActive then stopAllMusicSafe(true) end
                                    isServerActive=false
                                    if ts~=0 then lastMusicTs=ts end
                                    addSystemMessage("🔇 Server stopped by "..(data.by or "STAFF"), PAL.ACCENT_2)
                                elseif action=="play" and assetId~="" then
                                    lastMusicTs=ts stopAllMusicSafe(true) isServerActive=true
                                    playMusicSafe(assetId,"server")
                                    addSystemMessage("🎧 SERVER: "..tostring(assetId):gsub("%D",""), PAL.SUCCESS)
                                end
                            else
                                if ts~=0 then lastMusicTs=ts end
                            end
                        end
                    end
                end
                musicFetchInProgress=false
            end)
            musicFetchInProgress=false
        end
    end)

