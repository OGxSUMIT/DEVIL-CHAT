local function buildUI()
    local H={} -- holds helper functions (keeps buildUI under the 200 local limit)

    -- ==============================================================
    -- ANIMATION HELPERS
    -- ==============================================================
    function H.tween(obj, info, props)
        local ok,t=pcall(function() local tw=TweenService:Create(obj, info, props) tw:Play() return tw end)
        return ok and t or nil
    end
    local FADE_PROPS={
        Frame={"BackgroundTransparency"}, ScrollingFrame={"BackgroundTransparency"},
        TextLabel={"BackgroundTransparency","TextTransparency"}, TextButton={"BackgroundTransparency","TextTransparency"},
        TextBox={"BackgroundTransparency","TextTransparency"}, ImageLabel={"BackgroundTransparency","ImageTransparency"},
        ImageButton={"BackgroundTransparency","ImageTransparency"}, UIStroke={"Transparency"},
    }
    function H.fadeIn(root, dur, maxN)
        if not root then return end
        pcall(function()
            local list={root}
            for _,d in ipairs(root:GetDescendants()) do
                list[#list+1]=d
                if #list>=(maxN or 40) then break end
            end
            for _,o in ipairs(list) do
                local props=FADE_PROPS[o.ClassName]
                if props then
                    local goal={}
                    for _,pr in ipairs(props) do
                        local v=o[pr]
                        if v<1 then goal[pr]=v o[pr]=1 end
                    end
                    if next(goal) then
                        H.tween(o, TweenInfo.new(dur or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
                    end
                end
            end
        end)
    end
    function H.getScale(obj)
        local sc=obj:FindFirstChild("FXScale")
        if not sc then sc=Instance.new("UIScale") sc.Name="FXScale" sc.Parent=obj end
        return sc
    end
    function H.centerAnchor(obj)
        pcall(function()
            if obj.AnchorPoint~=Vector2.new(0.5,0.5) then
                local a=obj.AbsoluteSize
                if a.X<=0 then a=Vector2.new(obj.Size.X.Offset, obj.Size.Y.Offset) end
                if a.X>0 then
                    obj.Position=obj.Position+UDim2.fromOffset(a.X*(0.5-obj.AnchorPoint.X), a.Y*(0.5-obj.AnchorPoint.Y))
                    obj.AnchorPoint=Vector2.new(0.5,0.5)
                end
            end
        end)
    end
    function H.popIn(obj, from, dur)
        if not obj then return end
        pcall(function()
            obj:SetAttribute("fxTick", (obj:GetAttribute("fxTick") or 0)+1)
            H.centerAnchor(obj)
            local sc=H.getScale(obj)
            sc.Scale=from or 0.85
            H.tween(sc, TweenInfo.new(dur or 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1})
        end)
    end
    function H.popOut(obj, cb)
        if not obj then return end
        local ok=pcall(function()
            local tick=(obj:GetAttribute("fxTick") or 0)+1
            obj:SetAttribute("fxTick", tick)
            H.centerAnchor(obj)
            local sc=H.getScale(obj)
            H.tween(sc, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale=0.88})
            task.delay(0.17, function()
                if obj.Parent and obj:GetAttribute("fxTick")==tick then
                    obj.Visible=false
                    sc.Scale=1
                    if cb then cb() end
                end
            end)
        end)
        if not ok then obj.Visible=false end
    end
    function H.pressFx(btn)
        pcall(function()
            local sc=H.getScale(btn)
            btn.MouseButton1Down:Connect(function() H.tween(sc, TweenInfo.new(0.08), {Scale=0.9}) end)
            local function up() H.tween(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1}) end
            btn.MouseButton1Up:Connect(up)
            btn.MouseLeave:Connect(up)
        end)
    end
    function H.slideIn(obj)
        pcall(function()
            local target=obj.Position
            obj.Position=target-UDim2.fromOffset(0,90)
            H.tween(obj, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position=target})
        end)
    end
    function H.slideOut(obj)
        pcall(function()
            H.tween(obj, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position=obj.Position-UDim2.fromOffset(0,90)})
        end)
    end
