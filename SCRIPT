local function fileHash(path)
    if not readfile then return nil end
    local ok,data=pcall(readfile,path)
    if not ok or not data or #data==0 then return nil end
    local h=5381 local len=math.min(#data,4000)
    for i=1,len do h=((h*33)+string.byte(data,i))%4294967296 end
    return string.format("%08x_%d",h,#data)
end
local function dataHash(data)
    if type(data)~="string" or #data==0 then return nil end
    local h=5381 local len=math.min(#data,4000)
    for i=1,len do h=((h*33)+string.byte(data,i))%4294967296 end
    return string.format("%08x_%d",h,#data)
end
local function isUsableMemeAsset(assetId)
    local id=tostring(assetId or ""):gsub("^%s+",""):gsub("%s+$","")
    if id=="" or id=="0" or id:lower()=="nil" or id:lower()=="null" then return false end
    if id:lower()=="rbxassetid://0" or id:lower()=="rbxasset://0" then return false end
    return true
end
local function memeServerKey(value)
    value=tostring(value or "") local h=5381
    for i=1,#value do h=((h*33)+string.byte(value,i))%4294967296 end
    return string.format("m_%08x_%d",h,#value)
end

local lastDedupTime=0
local function dedupWorkspaceMemeFiles(force)
    local now=os.clock()
    if not force and now-lastDedupTime<DEDUP_COOLDOWN then return end
    lastDedupTime=now
    ensureFolder(WORKSPACE_MEME_FOLDER)
    local groups={}
    for _,path in ipairs(listMemeFiles(true)) do
        local hash=fileHash(path)
        if hash then groups[hash]=groups[hash] or {} table.insert(groups[hash],path)
        elseif delfile then pcall(delfile,path) end
    end
    for hash,paths in pairs(groups) do
        local ext=tostring(paths[1]):match("(%.[^%.]+)$") or ".png"
        local canonical=WORKSPACE_MEME_FOLDER.."/"..hash..ext
        local canonicalExists=isfile and isfile(canonical)
        if not canonicalExists and readfile and writefile then
            local ok,data=pcall(readfile,paths[1])
            if ok and data and #data>0 then canonicalExists=pcall(writefile,canonical,data) end
        end
        if canonicalExists and delfile then for _,path in ipairs(paths) do if tostring(path)~=canonical then pcall(delfile,path) end end end
    end
    invalidateMemeListCache()
end

