    playMusicSafe = function(assetId, mType, rawSoundId, startAtMs, resumeLateJoin)
        local clean = tostring(assetId):gsub("%D","")
        local scheduledStartMs = tonumber(startAtMs)
        if scheduledStartMs and scheduledStartMs < 1000000000000 then scheduledStartMs=nil end
        if not rawSoundId and (clean=="" or clean=="0") then
            if addSystemMessage then addSystemMessage("Invalid asset ID", Color3.fromRGB(255,100,100)) end
            return nil
        end
        if isServerActive and mType=="client" then
            if addSystemMessage then addSystemMessage("🔇 Server active! Stop server first.", Color3.fromRGB(255,100,100)) end
            return nil
        end
        stopAllMusicSafe(mType=="server")
        local s = nil
        local ok, err = pcall(function()
            s = Instance.new("Sound")
            s.Name="RX_Music"
            s.SoundId=rawSoundId or ("rbxassetid://"..clean)
            s.Volume=1
            s.Looped=false
            s.Parent=workspace
            if not scheduledStartMs then s:Play() end
        end)
        if not ok or not s then
            if s then pcall(function() s:Destroy() end) end
            warn("[DEVIL Music] Sound create failed: "..tostring(err))
            if addSystemMessage then addSystemMessage("Audio "..clean.." failed - private/missing?", Color3.fromRGB(255,120,100)) end
            return nil
        end
        currentSound=s
        currentMusicType=mType
        if mType=="server" then isServerActive=true else isServerActive=false end
        s.Ended:Connect(function()
            pcall(function()
                if currentSound==s then
                    currentSound=nil currentMusicType=nil
                    if mType=="server" then isServerActive=false end
                end
            end)
        end)
        if scheduledStartMs then
            local playbackToken = MX.token
            local preserveTrackStart = rawSoundId ~= nil and resumeLateJoin ~= true -- Normal MP3 broadcasts begin at 0; late joiners resume the current position.
            local function seekToSharedPosition()
                if preserveTrackStart then return true end
                if not (s.IsLoaded and s.TimeLength>0) then return true end
                local elapsed = math.max(0, (sharedMusicClockMs()-scheduledStartMs)/1000)
                if elapsed >= s.TimeLength then
                    if currentSound==s then
                        currentSound=nil currentMusicType=nil
                        if mType=="server" then isServerActive=false end
                    end
                    pcall(function() s:Stop() s:Destroy() end)
                    return false
                end
                if elapsed > 0.05 then pcall(function() s.TimePosition=elapsed end) end
                return true
            end
            task.spawn(function()
                while currentSound==s and MX.token==playbackToken and s.Parent do
                    local remaining=(scheduledStartMs-sharedMusicClockMs())/1000
                    if remaining<=0 then break end
                    task.wait(math.min(remaining,0.1))
                end
                if currentSound~=s or MX.token~=playbackToken or not s.Parent then return end
                if resumeLateJoin then
                    local waitedForLoad=0
                    while currentSound==s and MX.token==playbackToken and s.Parent and not s.IsLoaded and waitedForLoad<20 do
                        task.wait(0.1) waitedForLoad=waitedForLoad+0.1
                    end
                    if currentSound~=s or MX.token~=playbackToken or not s.Parent then return end
                end
                local started, startErr = pcall(function()
                    if not seekToSharedPosition() then return end
                    s:Play()
                end)
                if not started then
                    if currentSound==s then
                        currentSound=nil currentMusicType=nil
                        if mType=="server" then isServerActive=false end
                    end
                    pcall(function() s:Destroy() end)
                    warn("[DEVIL Music] scheduled playback failed: "..tostring(startErr))
                    return
                end
                task.spawn(function()
                    local waited=0
                    while currentSound==s and MX.token==playbackToken and s.Parent and not s.IsLoaded and waited<20 do
                        task.wait(0.1) waited=waited+0.1
                    end
                    if currentSound==s and MX.token==playbackToken and s.Parent and s.IsLoaded then
                        pcall(seekToSharedPosition)
                    end
                end)
            end)
        end
        return s
    end


    -- ==================================================================
    -- RX MUSIC LIBRARY: .mp3 from workspace/rx_music, synced via Firebase (same idea as rx_memes)
    -- ==================================================================
    do
        local RED = Color3.fromRGB(255,100,100)
        local BLUE = Color3.fromRGB(150,200,255)
        local function sysMsg(t, c) if addSystemMessage then addSystemMessage(t, c) end end
        local function chunkKey(i) return string.format("c%04d", i) end

        -- Full-file dual hash = Firebase key = dedupe key; local deletion also verifies exact bytes.
        local function hashData(data)
            if type(data)~="string" or #data==0 then return nil end
            local n = #data
            local h1, h2 = 5381, 0
            for i = 1, n do
                local byte = string.byte(data, i)
                h1 = ((h1*33)+byte)%4294967296
                h2 = ((h2*65599)+byte)%4294967296
                if i%65536==0 then task.wait() end
            end
            return string.format("%08x%08x_%d", h1, h2, n)
        end
        -- Keep older V10 library entries readable while new uploads use the full-file hash above.
        local function legacyHashData(data)
            if type(data)~="string" or #data==0 then return nil end
            local n, h = #data, 5381
            local function feed(a, b)
                for i=a,b do h=((h*33)+string.byte(data,i))%4294967296 end
            end
            if n<=12000 then
                feed(1,n)
            else
                local mid=math.floor(n/2)
                feed(1,4000) feed(mid-2000,mid+1999) feed(n-3999,n)
            end
            return string.format("%08x_%d",h,n)
        end
        local function hashFile(path)
            if not readfile then return nil end
            local ok, data = pcall(readfile, path)
            if not ok then return nil end
            return hashData(data)
        end
        local function fileMatchesHash(path, targetHash)
            if not readfile then return false end
            local ok, data = pcall(readfile, path)
            return ok and (hashData(data)==targetHash or legacyHashData(data)==targetHash)
        end
        local function localFileExists(path)
            if isfile then
                local ok, exists = pcall(isfile, path)
                if ok and exists then return true end
            end
            if listfiles then
                local ok, files = pcall(listfiles, MX.folder)
                if ok and type(files)=="table" then
                    local wanted = (tostring(path):match("([^/\\]+)$") or tostring(path)):lower()
                    for _, f in ipairs(files) do
                        local listed = (tostring(f):match("([^/\\]+)$") or tostring(f)):lower()
                        if listed==wanted then return true end
                    end
                end
            end
            return false
        end
        local function localSongPath(meta, hash)
            local filename = type(meta)=="table" and (meta.fileName or meta.name) or nil
            filename = tostring(filename or hash):match("([^/\\]+)$") or tostring(hash)
            filename = filename:gsub("[%c:*?\"<>|]", "_"):gsub("^%s+", ""):gsub("%s+$", "")
            if filename=="" then filename=tostring(hash) end
            if not filename:lower():match("%.mp3$") then filename=filename..".mp3" end
            local path = MX.folder.."/"..filename
            if not localFileExists(path) or fileMatchesHash(path, hash) then return path end
            local stem = filename:gsub("%.mp3$", "")
            local suffix = tostring(hash):sub(1,8)
            for i=1,99 do
                local tail = suffix..(i>1 and "_"..tostring(i) or "")
                local candidate = MX.folder.."/"..stem.."_"..tail..".mp3"
                if not localFileExists(candidate) or fileMatchesHash(candidate, hash) then return candidate end
            end
            return path
        end
        local function normalizeLocalSongName(path, hash)
            if not path or not (readfile and writefile) then return path end
            local currentName = tostring(path):match("([^/\\]+)$") or tostring(path)
            if not currentName:match("^%x+_%d+%.mp3$") then return path end
            local meta = jsonDecode(httpGetFresh(MX.index.."/"..hash..".json") or "{}")
            if type(meta)~="table" or not (meta.fileName or meta.name) then return path end
            local target = localSongPath(meta, hash)
            if target==path then return path end
            if localFileExists(target) and fileMatchesHash(target, hash) then
                if delfile then pcall(delfile, path) end
                MX.hashCache[path] = nil
                MX.hashCache[target] = hash
                return target
            end
            local readOk, data = pcall(readfile, path)
            if not readOk or type(data)~="string" then return path end
            local writeOk = pcall(writefile, target, data)
            if not writeOk or not fileMatchesHash(target, hash) then return path end
            if delfile then pcall(delfile, path) end
            MX.hashCache[path] = nil
            MX.hashCache[target] = hash
            return target
        end

        local function findLocal(hash)
            if not listfiles then return nil end
            local ok, files = pcall(listfiles, MX.folder)
            if not ok or type(files)~="table" then return nil end
            for _,f in ipairs(files) do
                if tostring(f):lower():match("%.mp3$") then
                    local h = MX.hashCache[f]
                    if not h then h = hashFile(f) MX.hashCache[f] = h end
                    if h == hash or fileMatchesHash(f, hash) then return f end
                end
            end
            return nil
        end

        local function dedupeLocal(force)
            local now = os.clock()
            if not force and now - MX.lastDedup < 45 then return 0 end
            MX.lastDedup = now
            if not (listfiles and delfile and readfile) then return 0 end
            ensureFolder(MX.folder)
            local ok, files = pcall(listfiles, MX.folder)
            if not ok or type(files)~="table" then return 0 end
            local groups = {}
            for _,f in ipairs(files) do
                if tostring(f):lower():match("%.mp3$") then
                    local h = MX.hashCache[f]
                    if not h then h = hashFile(f) MX.hashCache[f] = h task.wait() end
                    if h then
                        groups[h] = groups[h] or {}
                        table.insert(groups[h], f)
                    end
                end
            end
            local removed = 0
            for h, paths in pairs(groups) do
                if #paths > 1 then
                    local scored = {}
                    for _,f in ipairs(paths) do
                        local fname = (tostring(f):match("([^/\\]+)$") or ""):lower()
                        local base = fname:gsub("%.mp3$","")
                        local score = (base==h and "1" or "0")..string.format("%04d", #fname)..fname
                        scored[#scored+1] = {path=f, score=score}
                    end
                    table.sort(scored, function(a,b) return a.score < b.score end)
                    local keepOk, keepData = pcall(readfile, scored[1].path)
                    if keepOk and type(keepData)=="string" then
                        for i = 2, #scored do
                            local dataOk, candidateData = pcall(readfile, scored[i].path)
                            if dataOk and candidateData==keepData and pcall(delfile, scored[i].path) then
                                removed = removed + 1
                                MX.hashCache[scored[i].path] = nil
                            end
                        end
                    end
                end
            end
            if removed > 0 then sysMsg("🧹 rx_music: removed "..removed.." duplicate song file(s)", Color3.fromRGB(100,255,100)) end
            return removed
        end
        MX.dedupe = dedupeLocal

        local function fetchIndex()
            local d = jsonDecode(httpGetFresh(MX.index..".json") or "{}")
            if type(d)~="table" then return {} end
            return d
        end

        local function uploadCore(path, hash, name)
            local existing = jsonDecode(httpGetFresh(MX.index.."/"..hash..".json") or "{}")
            if type(existing)=="table" and existing.chunks then return true end
            if not readfile then return false, "readfile unavailable" end
            local ok, data = pcall(readfile, path)
            if not ok or type(data)~="string" or #data==0 then return false, "could not read file" end
            if #data > MX.maxBytes then
                return false, string.format("too big (%.1f MB, max %.1f MB)", #data/1000000, MX.maxBytes/1000000)
            end
            local fileName = tostring(path):match("([^/\\]+)$") or tostring(name or "SONG")
            if not fileName:lower():match("%.mp3$") then fileName=fileName..".mp3" end
            local total = math.ceil(#data / MX.chunkRaw)
            for i = 1, total do
                local b64 = b64Encode(data:sub((i-1)*MX.chunkRaw+1, i*MX.chunkRaw))
                if not b64 or b64=="" then return false, "encode failed" end
                local body = jsonEncode({d=b64})
                local url = MX.root.."/"..hash.."/"..chunkKey(i)..".json"
                local put = nil
                for _=1,3 do
                    put = httpPut(url, body)
                    if put then break end
                    task.wait(0.5)
                end
                if not put then return false, "chunk "..i.."/"..total.." failed (check Firebase rules)" end
                task.wait(#data>8000000 and 0.75 or 0.05) -- throttle larger uploads; preserve existing pacing for <=8 MB files
            end
            -- index is written LAST: if it exists, every chunk is already there
            local put = httpPut(MX.index.."/"..hash..".json", jsonEncode({
                name=name, fileName=fileName, size=#data, chunks=total, by=player.Name, timestamp=os.time()*1000
            }))
            if not put then return false, "index write failed" end
            return true
        end

        local function uploadSong(path, hash, name)
            if MX.inflightUp[hash] then return false, "already uploading" end
            MX.inflightUp[hash] = true
            local ok, a, b = pcall(uploadCore, path, hash, name)
            MX.inflightUp[hash] = nil
            if not ok then return false, tostring(a) end
            return a, b
        end

        local function ensureLocal(hash)
            local found = findLocal(hash)
            if found then return normalizeLocalSongName(found, hash) end
            if MX.inflight[hash] then
                local t0 = os.clock()
                while MX.inflight[hash] and os.clock()-t0 < 90 do task.wait(0.25) end
                local ready = findLocal(hash)
                return ready and normalizeLocalSongName(ready, hash) or nil
            end
            MX.inflight[hash] = true
            MX.lastError = nil
            local resultPath = nil
            local ok, err = pcall(function()
                local meta = jsonDecode(httpGetFresh(MX.index.."/"..hash..".json") or "{}")
                if type(meta)~="table" then MX.lastError = "invalid song metadata" return end
                local total = tonumber(meta.chunks)
                if not total or total < 1 or total%1~=0 or total>math.ceil(MX.maxBytes/MX.chunkRaw) then
                    MX.lastError = "invalid or oversized song metadata (check synced_music_index rules)"
                    return
                end
                local declaredSize = type(meta)=="table" and tonumber(meta.size) or nil
                if meta.size~=nil and (not declaredSize or declaredSize<1 or declaredSize>MX.maxBytes) then
                    MX.lastError = "invalid song size metadata"
                    return
                end
                if declaredSize and math.ceil(declaredSize/MX.chunkRaw)~=total then
                    MX.lastError = "song size/chunk metadata mismatch"
                    return
                end
                local parts = {}
                local totalBytes = 0
                for i = 1, total do
                    local d = nil
                    for _=1,3 do
                        local o = jsonDecode(httpGetFresh(MX.root.."/"..hash.."/"..chunkKey(i)..".json") or "{}")
                        if type(o)=="table" and type(o.d)=="string" and o.d~="" then d = o.d break end
                        task.wait(0.3)
                    end
                    if not d then MX.lastError = "chunk "..i.."/"..total.." could not be downloaded" return end
                    local raw = b64Decode(d)
                    if not raw or raw=="" then MX.lastError = "base64 decode failed" return end
                    totalBytes = totalBytes + #raw
                    if totalBytes>MX.maxBytes then MX.lastError = "download exceeds maximum song size" return end
                    parts[i] = raw
                    task.wait()
                end
                local data = table.concat(parts)
                if declaredSize and #data~=declaredSize then MX.lastError = "downloaded size does not match metadata" return end
                if hashData(data)~=hash and legacyHashData(data)~=hash then
                    MX.lastError = "downloaded file is damaged (hash mismatch)"
                    return
                end
                ensureFolder(MX.folder)
                local path = localSongPath(meta, hash)
                if writefile and pcall(writefile, path, data) then
                    MX.hashCache[path] = hash
                    resultPath = path
                else
                    MX.lastError = "writefile failed (executor can't save files)"
                end
            end)
            MX.inflight[hash] = nil
            if not ok then warn("[DEVIL Music] download error: "..tostring(err)) end
            return resultPath
        end

        -- Plays rx_music tracks at the broadcast's shared server-time start; t0 remains the legacy fallback.
        MX.playSynced = function(hash, name, mType, byName, t0, startAtMs, resumeLateJoin)
            local myToken = MX.token
            local label = tostring(name or "SONG")
            local sharedStartMs = tonumber(startAtMs)
            if sharedStartMs and sharedStartMs < 1000000000000 then sharedStartMs=nil end
            local path = findLocal(hash)
            if path then path = normalizeLocalSongName(path, hash) end
            if not path then
                sysMsg("⬇ Loading song: "..label.."…", BLUE)
                path = ensureLocal(hash)
            end
            if MX.token ~= myToken then return end
            local asset = path and pathToAsset(path) or nil
            if not (path and isUsableMemeAsset(asset)) then
                if mType=="server" then isServerActive = false end
                local why = path and "getcustomasset failed (executor can't play mp3 files)" or (MX.lastError or "download failed")
                sysMsg("❌ Could not load song: "..label.." - "..why, RED)
                return
            end
            if MX.token ~= myToken then return end
            local s = playMusicSafe(hash, mType, asset, sharedStartMs, resumeLateJoin)
            if not s then
                if mType=="server" then isServerActive = false end
                return
            end
            if mType=="server" then
                sysMsg("🔊 SERVER: "..label.." BY "..string.upper(tostring(byName or player.DisplayName)), Color3.fromRGB(0,255,150))
            else
                sysMsg("▶ Client: "..label, Color3.fromRGB(100,255,100))
            end
            if t0 and not sharedStartMs and mType~="server" then
                task.spawn(function()
                    local waited = 0
                    while s.Parent and not s.IsLoaded and waited < 8 do task.wait(0.1) waited = waited + 0.1 end
                    local el = os.clock() - t0
                    pcall(function()
                        if s.Parent and el > 1.5 and s.TimeLength > 0 and el < s.TimeLength - 1 then s.TimePosition = el end
                    end)
                end)
            end
        end

        -- returns number of removed entries, or nil if the database could not be read (then nothing is deleted)
        MX.cleanFirebase = function()
            local ir = httpGetFresh(MX.index..".json")
            if ir == nil or tostring(ir):find('"error"', 1, true) then return nil end
            local idx = jsonDecode(ir)
            if type(idx)~="table" then idx = {} end
            local sr = httpGetFresh(MX.root..".json?shallow=true")
            if sr == nil or tostring(sr):find('"error"', 1, true) then return nil end
            local keys = jsonDecode(sr)
            if type(keys)~="table" then keys = {} end
            local removed = 0
            for h in pairs(keys) do
                local m = idx[h]
                if not (type(m)=="table" and m.chunks) then
                    if httpDelete(MX.root.."/"..h..".json") then removed = removed + 1 end
                end
            end
            for h, m in pairs(idx) do
                if type(m)=="table" and m.chunks and not keys[h] then
                    if httpDelete(MX.index.."/"..h..".json") then removed = removed + 1 end
                end
            end
            return removed
        end

        local function buildLibrary()
            dedupeLocal(false)
            ensureFolder(MX.folder)
            local byHash, order = {}, {}
            if listfiles then
                local ok, files = pcall(listfiles, MX.folder)
                if ok and type(files)=="table" then
                    for _,f in ipairs(files) do
                        if tostring(f):lower():match("%.mp3$") then
                            local h = MX.hashCache[f]
                            if not h then h = hashFile(f) MX.hashCache[f] = h task.wait() end
                            if h and not byHash[h] then
                                local fname = tostring(f):match("([^/\\]+)$") or "SONG"
                                local e = {hash=h, name=(fname:gsub("%.[^.]+$","")), localPath=f}
                                byHash[h] = e
                                order[#order+1] = e
                            end
                        end
                    end
                end
            end
            for h, m in pairs(fetchIndex()) do
                if type(m)=="table" and m.chunks then
                    local e = byHash[h]
                    if not e then e = {hash=h, name="SONG"} byHash[h] = e order[#order+1] = e end
                    e.remote = true
                    if m.name and m.name~="" then e.name = tostring(m.name) end
                end
            end
            table.sort(order, function(a,b) return tostring(a.name):lower() < tostring(b.name):lower() end)
            return order
        end

        MX.prepareInFlight = MX.prepareInFlight or {}
        local function reportMusicReady(sessionId, hash, ready, note)
            local sid = safeMusicSessionId(sessionId)
            if sid=="" then return false end
            local body = jsonEncode({
                userId=player.UserId, hash=tostring(hash or ""), ready=ready==true,
                readyAt={ [".sv"]="timestamp" }, note=note and tostring(note):sub(1,120) or nil
            })
            return httpPut(MUSIC_READY_ROOT.."/"..sid.."/"..tostring(player.UserId)..".json", body)~=nil
        end

        MX.prepareSynced = function(hash, name, sessionId)
            local sid = safeMusicSessionId(sessionId)
            hash = tostring(hash or "")
            if sid=="" or MX.activePrepareId~=sid then return false end
            if MX.prepareInFlight[sid] then return false end
            MX.prepareInFlight[sid] = true
            local prepared, reason = false, nil
            local ok, result, prepareReason = pcall(function()
                local path = findLocal(hash)
                if path then path = normalizeLocalSongName(path, hash) end
                if not path then
                    sysMsg("⬇ Preparing server song: "..tostring(name or "SONG"), BLUE)
                    path = ensureLocal(hash)
                end
                if not path then return false, MX.lastError or "download failed" end
                local asset = pathToAsset(path)
                if not isUsableMemeAsset(asset) then return false, "local MP3 is not playable" end
                return true, nil
            end)
            if ok and result==true then prepared=true
            elseif not ok then reason=tostring(result)
            else reason=tostring(prepareReason or MX.lastError or "download failed") end
            MX.prepareInFlight[sid] = nil
            if MX.activePrepareId==sid then
                reportMusicReady(sid, hash, prepared, reason)
                if not prepared then sysMsg("⚠ Could not prepare "..tostring(name or "SONG")..": "..tostring(reason or "unknown error"), RED) end
            end
            return prepared
        end

        local function readinessStatus(sessionId, hash)
            local presenceRaw = httpGetFresh(PRESENCE_URL)
            local presence = jsonDecode(presenceRaw or "{}")
            if type(presence)~="table" then return false, nil, nil end
            local nowMs = sharedMusicClockMs()
            local reportedNow = tonumber(presence._now)
            if reportedNow and reportedNow>0 then nowMs=reportedNow end
            local clients = { [tostring(player.UserId)]=true }
            for fbKey, entry in pairs(presence) do
                if type(entry)=="table" then
                    local uid = tostring(entry.userId or fbKey)
                    local lastSeen = tonumber(entry.lastSeen) or 0
                    if uid~="" and uid~="0" and uid~="nil" and lastSeen>0 and nowMs-lastSeen<40000 then
                        clients[uid] = true
                    end
                end
            end
            local readyRaw = httpGetFresh(MUSIC_READY_ROOT.."/"..safeMusicSessionId(sessionId)..".json")
            local readyData = jsonDecode(readyRaw or "{}")
            if type(readyData)~="table" then readyData={} end
            local total, missing = 0, 0
            for uid in pairs(clients) do
                total = total + 1
                local ack = readyData[uid]
                if type(ack)~="table" or ack.ready~=true or tostring(ack.hash or "")~=tostring(hash) then
                    missing = missing + 1
                end
            end
            return missing==0, missing, total
        end

        local function broadcastSong(e)
            if myRole=="none" then sysMsg("🔒 Locked - staff only", Color3.fromRGB(255,80,80)) return end
            if not e.remote then
                if not e.localPath then return end
                sysMsg("☁ Uploading "..e.name.."… (first time only)", BLUE)
                local ok, err = uploadSong(e.localPath, e.hash, e.name)
                if not ok then sysMsg("❌ Upload failed: "..tostring(err), RED) return end
                e.remote = true
                if MX.refresh then MX.refresh() end
            end
            stopAllMusicSafe(true)
            isServerActive = true
            local previousPrepare = MX.activePrepareId
            local sessionId = safeMusicSessionId(generateGUID())
            if sessionId=="" then sessionId=tostring(player.UserId).."_"..tostring(os.time()) end
            MX.activePrepareId = sessionId
            if previousPrepare then task.spawn(function() pcall(function() httpDelete(MUSIC_READY_ROOT.."/"..safeMusicSessionId(previousPrepare)..".json") end) end) end
            lastMusicTs = os.time()*1000
            local msg = "🔊 SERVER MUSIC: "..e.name.." [SESSION]"
            -- Prepare/download first. The play state is published only after active clients acknowledge readiness.
            local payload = {assetId="0", musicAssetId="0", musicType="file", musicHash=e.hash, musicName=e.name,
                action="prepare", musicAction="prepare", by=player.DisplayName, byUserId=player.UserId, role=myRole,
                timestamp=lastMusicTs, isMusic=true, sessionOnly=true, name=player.Name, displayName=player.DisplayName,
                id=sessionId, sessionId=sessionId, message=msg}
            if not httpPut(MUSIC_PRESENCE_URL, jsonEncode(payload)) then
                MX.activePrepareId=nil
                isServerActive=false
                sysMsg("❌ Could not announce the server song preparation to Firebase.", RED)
                return
            end
            sysMsg("⏳ Preparing "..e.name.." for online Devil Chat clients…", BLUE)
            task.spawn(function() pcall(MX.prepareSynced, e.hash, e.name, sessionId) end)
            task.spawn(function()
                local deadline = os.clock() + MUSIC_READY_TIMEOUT_MS/1000
                local allReady, missingCount, totalCount = false, nil, nil
                while alive and MX.activePrepareId==sessionId and os.clock()<deadline do
                    allReady, missingCount, totalCount = readinessStatus(sessionId, e.hash)
                    if allReady then break end
                    task.wait(0.5)
                end
                if not alive or MX.activePrepareId~=sessionId then return end
                if allReady then
                    sysMsg("✅ All "..tostring(totalCount or 0).." live client(s) downloaded the song.", Color3.fromRGB(0,255,150))
                else
                    sysMsg("⚠ Timed out waiting for "..tostring(missingCount or "some").." client(s); starting anyway.", Color3.fromRGB(255,200,100))
                end
                local playPayload = {}
                for k, v in pairs(payload) do playPayload[k]=v end
                local startAt = sharedMusicClockMs() + MUSIC_SYNC_START_LEAD_MS
                playPayload.action="play"
                playPayload.musicAction="play"
                playPayload.timestamp=os.time()*1000
                playPayload.startAt=startAt
                local playBody = jsonEncode(playPayload)
                local published = nil
                for _=1,3 do
                    published = httpPut(MUSIC_PRESENCE_URL, playBody)
                    if published then break end
                    task.wait(0.5)
                end
                if not published then
                    MX.activePrepareId=nil
                    isServerActive=false
                    sysMsg("❌ Could not publish the synchronized start to Firebase.", RED)
                    return
                end
                MX.activePrepareId=nil
                lastMusicTs=tonumber(playPayload.timestamp) or lastMusicTs
                if addChatMessage then addChatMessage(player.DisplayName, msg, true, myRole, player.UserId, nil, nil, nil, nil, player.Name) end
                task.spawn(function() pcall(function() httpPost(FIREBASE_URL, jsonEncode(playPayload)) end) end)
                pcall(MX.playSynced, e.hash, e.name, "server", nil, nil, startAt)
                task.delay(3, function()
                    pcall(function() httpDelete(MUSIC_READY_ROOT.."/"..sessionId..".json") end)
                end)
            end)
        end

