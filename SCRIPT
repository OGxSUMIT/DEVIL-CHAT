        title.TextColor3=PAL.ACCENT_2 title.TextSize=12
        title.Font=Enum.Font.GothamBlack title.TextXAlignment=Enum.TextXAlignment.Left
        title.ZIndex=202 title.Parent=titleBar
        local close=Instance.new("TextButton")
        close.Size=UDim2.new(0,30,0,30) close.Position=UDim2.new(1,-30,0,0)
        close.BackgroundTransparency=1 close.Text="X" close.TextColor3=PAL.DANGER
        close.TextSize=14 close.Font=Enum.Font.GothamBold close.ZIndex=202 close.Parent=titleBar
        close.MouseButton1Click:Connect(function() H.popOut(blockedUsersWindow) end)
        makeDraggable(titleBar, {close}, blockedUsersWindow)
        blockedUsersScroller=Instance.new("ScrollingFrame")
        blockedUsersScroller.Size=UDim2.new(1,-10,1,-40) blockedUsersScroller.Position=UDim2.new(0,5,0,36)
        blockedUsersScroller.BackgroundColor3=PAL.PANEL blockedUsersScroller.BorderSizePixel=0
        blockedUsersScroller.ScrollBarThickness=4 blockedUsersScroller.ScrollBarImageColor3=PAL.ACCENT
        blockedUsersScroller.CanvasSize=UDim2.new(0,0,0,0) blockedUsersScroller.ZIndex=201
        blockedUsersScroller.Parent=blockedUsersWindow
        local blc=Instance.new("UICorner") blc.CornerRadius=UDim.new(0,8) blc.Parent=blockedUsersScroller
        local layout=Instance.new("UIListLayout")
        layout.SortOrder=Enum.SortOrder.LayoutOrder layout.Padding=UDim.new(0,3) layout.Parent=blockedUsersScroller
        H.refreshBlockedUsersWindow()
        H.popIn(blockedUsersWindow, 0.88, 0.3)
    end

    task.defer(function() H.popIn(frame, 0.85, 0.45) end)

    -- Startup messages
    addSystemMessage("Welcome to DEVIL CHAT, "..getNick(player.UserId, player.DisplayName).."!", PAL.ACCENT_2)
    addSystemMessage("/syncmemes to sync memes", PAL.SUCCESS)
    addSystemMessage("/stopsyncmemes to stop", PAL.SUCCESS)
    addSystemMessage("/help for commands", PAL.SUCCESS)
    task.spawn(function()
        if alive then
            local welcomeAvatar=H.getAvatar(player.UserId)
            if alive then H.showWelcomeCard(getNick(player.UserId, player.DisplayName), welcomeAvatar) end
        end
    end)
    task.spawn(function()
        task.wait(3)
        if alive then
            local joinSlot=math.floor(os.time()/1800)
            local isOwnerSender=(myRole=="owner" or myRole=="author")
            local joinId="join_"..tostring(player.UserId).."_"..tostring(joinSlot)
            if isOwnerSender then joinId=joinId.."_"..tostring(os.time()).."_"..tostring(math.random(1000,9999)) end
            pcall(function()
                httpPost(FIREBASE_URL, jsonEncode({
                    name=player.Name,
                    displayName=player.DisplayName,
                    userId=player.UserId,
                    message=player.DisplayName.." joined Devil Chat",
                    timestamp={[".sv"]="timestamp"},
                    id=joinId,
                    role=myRole,
                    system=true,
                    event="join"
                }))
            end)
        end
    end)

    -- Presence heartbeat
    task.spawn(function()
        while alive do
            pcall(function()
                httpPut(PRESENCE_ROOT.."/"..tostring(player.UserId)..".json", jsonEncode({
                    name=player.Name, displayName=player.DisplayName, userId=player.UserId,
                    lastSeen={[".sv"]="timestamp"}, role=myRole
                }))
            end)
            task.wait(PRESENCE_INTERVAL)
        end
        pcall(function()
            local resp=httpGetFresh(MUSIC_PRESENCE_URL)
            local data=jsonDecode(resp or "{}")
            if data and tonumber(data.byUserId)==player.UserId then httpDelete(MUSIC_PRESENCE_URL) end
        end)
    end)

    -- Blocks poll
    task.spawn(function()
        while alive do
            pcall(function() H.fetchGlobalBlocks(false) end)
            if onlinePanel.Visible then pcall(function() refreshOnlineList(true) end) end
            task.wait(BLOCKS_INTERVAL)
        end
    end)

    -- Control poll (kick/block)
    task.spawn(function()
        while alive do
            pcall(function()
                local raw=httpGetFresh(CONTROL_URL)
                local control=jsonDecode(raw or "{}")
                local controlTime=tonumber(control.timestamp) or 0
                if control.action=="kick" and controlTime>=SESSION_STARTED_AT and not hasNotifiedKick then
                    hasNotifiedKick=true
                    addSystemMessage("You were kicked by "..tostring(control.by or "moderator"), PAL.DANGER)
                    task.wait(1)
                    pcall(function() httpDelete(PRESENCE_ROOT.."/"..tostring(player.UserId)..".json") end)
                    sg:Destroy()
                    return
                elseif control.action=="block" and controlTime>=SESSION_STARTED_AT then
                    unblockPending=true
                    if not hasNotifiedBlock then
                        blockedUsers["__ALL__"]=true
                        addSystemMessage("You have been blocked.", PAL.DANGER)
                        hasNotifiedBlock=true
                    else
                        blockedUsers["__ALL__"]=true
                    end
                else
                    if not globalBlocks[tostring(player.UserId)] and control.action~="block" then
                        if hasNotifiedBlock then
                            blockedUsers["__ALL__"]=nil
                            hasNotifiedBlock=false
                        end
                        if unblockPending then
                            unblockPending=false
                            blockedUsers["__ALL__"]=nil
                            addSystemMessage("You are unblocked! ✅", PAL.SUCCESS)
                        end
                    end
                end
            end)
            task.wait(CONTROL_INTERVAL)
        end
    end)

    -- Message poll
    task.spawn(function()
        while alive do
            task.wait(POLL_INTERVAL)
            H.safeRuntimeCall(H.fetchNewMessages)
        end
    end)

    H.addSystemLinkMessage("https://downloadrxchatapp.netlify.app/")
    addSystemMessage("😈 DEVIL CHAT CONNECTED 😈🔥", PAL.ACCENT_2)
    scrollToLatest()
    task.spawn(function()
        task.wait(0.15)
        if alive then H.safeRuntimeCall(H.fetchNewMessages) end
    end)
    task.spawn(function()
        task.wait(0.45)
        if alive then pcall(function() refreshOnlineList(true) end) end
    end)
    print("[DEVIL] buildUI() finished — V2.1 ready")
end

