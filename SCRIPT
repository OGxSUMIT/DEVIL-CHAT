    function H.showToast(sender, displayName, msg, imageUrl, isSystem, opts)
        if not alive then return end
        opts=opts or {}
        local MT=H.MT
        if MT.onlyWhenClosed and frame.Visible then return end
        local role=resolveRole(opts.role, opts.userId)
        local isPrivate=opts.private==true
        local text=sanitizeUtf8(msg or "")
        if opts.sticker then text="📷 sent a meme" end
        if isPrivate then text="🔒 "..text end
        text=utf8TruncateEnd(text, 70)
        local key=isSystem and "__system" or tostring(opts.userId or sender or displayName)

        -- same sender still on screen -> update that card (spam control)
        for _,e in ipairs(MT.live) do
            if e.key==key and not e.leaving then
                e.count=e.count+1
                e.body.Text=text
                e.badge.Text="×"..tostring(e.count) e.badge.Visible=true
                e.scale.Scale=1.05
                H.tween(e.scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1})
                e.arm()
                return
