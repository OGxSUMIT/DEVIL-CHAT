    function H.uploadWorkspaceMemes(runId)
        if runId and not H.memeSyncRunIsActive(runId) then return 0, true end
        if not readfile then return 0, false end
        dedupWorkspaceMemeFiles(true)
        ensureFolder(WORKSPACE_MEME_FOLDER)
        local files = listMemeFiles(true)
        local uploaded = 0
        local seenInThisRun = {}
        for _,path in ipairs(files) do
            if runId and not H.memeSyncRunIsActive(runId) then return uploaded, true end
            local hash = fileHash(path)
            if hash and not seenInThisRun[hash] then
                seenInThisRun[hash]=true
                local remoteCheck = httpGet(SYNCED_MEMES_ROOT.."/"..hash..".json")
                local remoteData = jsonDecode(remoteCheck or "{}")
                local needsUpload = true
                if remoteData and remoteData.data and remoteData.data~="" then needsUpload=false end
                if needsUpload then
                    local ok, data = pcall(readfile, path)
                    if ok and data and #data>0 and #data<=MAX_MEME_BYTES then
                        local b64 = b64Encode(data)
                        if b64 and b64~="" then
                            local fname = tostring(path):match("([^/\\]+)$") or "MEME"
                            local cleanName = fname:gsub("%.[^.]+$",""):gsub("%W","_")
                            local name = string.upper(cleanName:sub(1,20))
                            local ext = path:match("%.[^%.]+$") or ".png"
                            local putOk = httpPut(SYNCED_MEMES_ROOT.."/"..hash..".json", jsonEncode({name=name, data=b64, hash=hash, ext=ext, size=#data, by=player.Name, timestamp=os.time()*1000}))
                            if runId and not H.memeSyncRunIsActive(runId) then return uploaded, true end
                            if putOk then uploaded=uploaded+1 end
                        end
                    end
                end
                syncedHashes[hash]=true
                if runId and not H.memeSyncRunIsActive(runId) then return uploaded, true end
                if not H.hasStickerHash(hash) then
                    local assetId = pathToAsset(path)
                    if runId and not H.memeSyncRunIsActive(runId) then return uploaded, true end
                    if isUsableMemeAsset(assetId) then
                        local fname = tostring(path):match("([^/\\]+)$") or "MEME"
                        local cleanName = fname:gsub("%.[^.]+$",""):gsub("%W","_")
                        local name = string.upper(cleanName:sub(1,20))
                        local ext = path:match("%.[^%.]+$") or ".png"
                        if not H.hasStickerByHashOrId(hash, assetId) then
                            table.insert(MEME_STICKERS, {name=name, id=assetId, hash=hash, ext=ext, synced=true})
                        end
                    end
                end
            end
            task.wait(0.25)
        end
        dedupWorkspaceMemeFiles(true)
        H.dedupStickers()
        pcall(H.refreshStickers)
        return uploaded, false
    end

    function H.downloadRemoteMemes(runId)
        if runId and not H.memeSyncRunIsActive(runId) then return 0, true end
        dedupWorkspaceMemeFiles(true)
        local data = fetchPagedObject(SYNCED_MEMES_ROOT, 3)
        if type(data)~="table" then return 0 end
        ensureFolder(WORKSPACE_MEME_FOLDER)
        local loaded = 0
        for hash, entry in pairs(data) do
            if runId and not H.memeSyncRunIsActive(runId) then return loaded, true end
            if type(entry)=="table" and entry.data and entry.data~="" then
                local ext = entry.ext or ".png"
                local existingFile = fileExistsForHash(hash)
                local targetPath = existingFile or WORKSPACE_MEME_FOLDER.."/"..hash..ext
                if not existingFile then
                    local targetExists = isfile and isfile(targetPath)
                    if not targetExists and not downloadedStickerFiles[targetPath] then
                        downloadedStickerFiles[targetPath]=true
                        local raw = b64Decode(entry.data)
                        if raw and dataHash(raw)==tostring(hash) and writefile then
                            pcall(writefile, targetPath, raw)
                            invalidateMemeListCache()
                        end
                    end
                end
                if not H.hasStickerHash(hash) then
                    if runId and not H.memeSyncRunIsActive(runId) then return loaded, true end
                    local assetId = pathToAsset(targetPath)
                    if runId and not H.memeSyncRunIsActive(runId) then return loaded, true end
                    if not assetId or assetId=="" then task.wait(0.3) assetId = pathToAsset(targetPath) end
                    if runId and not H.memeSyncRunIsActive(runId) then return loaded, true end
                    if isUsableMemeAsset(assetId) then
                        if not H.hasStickerByHashOrId(hash, assetId) then
                            table.insert(MEME_STICKERS, {name=entry.name or "MEME", id=assetId, hash=hash, ext=ext, synced=true})
                            loaded=loaded+1
                        end
                    end
                    syncedHashes[hash]=true
                else syncedHashes[hash]=true end
            end
                task.wait(0.25)
                if runId and not H.memeSyncRunIsActive(runId) then return loaded, true end
            end
        dedupWorkspaceMemeFiles(true)
        H.dedupStickers()
        pcall(H.refreshStickers)
        return loaded, false
    end

    function H.runMemeSyncOnce(showNotice)
        if memeSyncInProgress and H.memeSyncRunIsActive(memeSyncActiveRunId) then
            if showNotice then addSystemMessage("Meme sync is already running.", Color3.fromRGB(255,200,100)) end
            return false
        end
        memeSyncInProgress=false
        if not showNotice and memeAutoSyncStarted then return false end
        if not showNotice then memeAutoSyncStarted=true end
        memeSyncInProgress=true
        memeSyncEnabled=true
        memeSyncRunId=memeSyncRunId+1
        local runId=memeSyncRunId
        memeSyncActiveRunId=runId
        task.spawn(function()
            local ok, cancelled = pcall(function()
                local _, uploadCancelled = H.uploadWorkspaceMemes(runId)
                if uploadCancelled or not H.memeSyncRunIsActive(runId) then return true end
                local _, downloadCancelled = H.downloadRemoteMemes(runId)
                if downloadCancelled or not H.memeSyncRunIsActive(runId) then return true end
                H.refreshStickers()
                return false
            end)
            if memeSyncActiveRunId==runId then
                memeSyncInProgress=false
                memeSyncActiveRunId=0
            end
            if showNotice and ok and not cancelled and H.memeSyncRunIsActive(runId) then
                addSystemMessage("rx_memes synced", Color3.fromRGB(100,255,100))
            elseif not ok then
                warn("[DEVIL] meme sync failed")
            end
        end)
        if not showNotice then
            task.delay(60, function()
                if memeSyncRunId==runId and memeSyncEnabled then
                    H.stopMemeSync()
                end
            end)
        end
        return true
    end

    function H.loadLocalMemesOnStartup()
        ensureFolder(WORKSPACE_MEME_FOLDER)
        dedupWorkspaceMemeFiles(true)
        H.dedupStickers()
        local files = listMemeFiles(true)
        local added = 0
        local seenLocal = {}
        for _,path in ipairs(files) do
            local hash = fileHash(path)
            if hash and not seenLocal[hash] and not H.hasStickerHash(hash) then
                seenLocal[hash]=true
                local assetId = pathToAsset(path)
                if not assetId or assetId=="" then task.wait(0.3) assetId = pathToAsset(path) end
                if isUsableMemeAsset(assetId) then
                    local fname = tostring(path):match("([^/\\]+)$") or "MEME"
                    local cleanName = fname:gsub("%.[^.]+$",""):gsub("%W","_")
                    local name = string.upper(cleanName:sub(1,20))
                    local ext = path:match("%.[^%.]+$") or ".png"
                    if not H.hasStickerByHashOrId(hash, assetId) then
                        table.insert(MEME_STICKERS, {name=name, id=assetId, hash=hash, ext=ext, synced=false})
                        added=added+1
                    end
                end
            end
            task.wait(0.1)
        end
        H.dedupStickers()
        return added
    end

    task.defer(function()
        if alive then pcall(H.loadLocalMemesOnStartup) end
        if alive then pcall(H.refreshStickers) end
        if alive then H.runMemeSyncOnce(false) end
    end)

    function H.addCustomSticker(assetId, name)
        if not assetId then return end
        local clean = assetId:gsub("%D","")
        if clean=="" then return end
        local finalId = "rbxassetid://"..clean
        if H.hasStickerByHashOrId(nil, finalId) then return end
        local sticker = {name=string.upper(name or "MEME"), id=finalId, by=player.Name, timestamp=os.time()*1000}
        local stickerKey = memeServerKey(finalId)
        httpPut(STICKERS_ROOT.."/"..stickerKey..".json", jsonEncode(sticker))
        if not H.hasStickerByHashOrId(sticker.hash, sticker.id) then table.insert(MEME_STICKERS, sticker) end
        H.refreshStickers()
    end

    function H.addCustomStickerURL(url, name)
        if not url then return end
        local stickerName = string.upper(name or "MEME_"..math.random(1000,9999))
        task.spawn(function()
            local finalId = url
            local path = WORKSPACE_MEME_FOLDER.."/"..stickerName..".png"
            ensureFolder(WORKSPACE_MEME_FOLDER)
            if writefile then
                local ok = false
                if Req then
                    local o, r = pcall(function() return Req({Url=url, Method="GET"}) end)
                    if o and r and r.Body and #r.Body>100 then pcall(writefile, path, r.Body) ok=true task.wait(0.4) end
                end
                if not ok then
                    local o, r = pcall(function() return game:HttpGet(url) end)
                    if o and r and #r>100 then pcall(writefile, path, r) ok=true task.wait(0.4) end
                end
                if ok then
                    invalidateMemeListCache()
                    local hash = fileHash(path)
                    if hash then
                        local ext = path:match("(%.[^%.]+)$") or ".png"
                        local canonical = WORKSPACE_MEME_FOLDER.."/"..hash..ext
                        if canonical~=path and not (isfile and isfile(canonical)) and readfile then
                            local ro, raw = pcall(readfile, path)
                            if ro and raw and writefile then pcall(writefile, canonical, raw) end
                        end
                        if canonical~=path and delfile and (isfile and isfile(canonical)) then pcall(delfile, path) end
                        path = canonical
                        invalidateMemeListCache()
                    end
                    local a = pathToAsset(path)
                    if a and a~="" then finalId=a end
                end
            end
            local stickerHash = fileHash(path)
            local sticker = {name=stickerName, id=finalId, hash=stickerHash or "", url=url, by=player.Name, timestamp=os.time()*1000}
            if not H.hasStickerByHashOrId(sticker.hash, sticker.id) then
                local stickerKey = memeServerKey(sticker.hash~="" and sticker.hash or url)
                httpPut(STICKERS_ROOT.."/"..stickerKey..".json", jsonEncode(sticker))
                table.insert(MEME_STICKERS, sticker)
                dedupWorkspaceMemeFiles(true)
                H.dedupStickers()
                H.refreshStickers()
            end
        end)
    end


    -- Command handler
    function H.handleCommand(text)
        local parts = {}
        for w in text:gmatch("%S+") do parts[#parts+1]=w end
        local cmd = parts[1] and parts[1]:lower() or ""
        if cmd=="/clear" then
            for _,child in pairs(scroller:GetChildren()) do
                if (child:IsA("TextLabel") or child:IsA("Frame")) and child.Name~="BottomSpacer" then child:Destroy() end
            end
            messageQueue = {}
            trackedHeight=0
            return true
        elseif cmd=="/clearall" then
            if myRole=="none" then
                addSystemMessage("🚫 Unauthorized command: /clearall", Color3.fromRGB(255,80,80))
                return true
            end
            H.clearAllMessages()
            return true
        elseif cmd=="/addmeme" then
            local id = parts[2] local name = parts[3] or "MEME"
            if id then H.addCustomSticker(id, name) return true end
            addSystemMessage("Usage: /addmeme 123177152458601 NAME", Color3.fromRGB(255,200,0)) return true
        elseif cmd=="/addmemeurl" then
            local url = parts[2] local name = parts[3] or "MEME"
            if url then H.addCustomStickerURL(url, name) return true end
            addSystemMessage("Usage: /addmemeurl <url> <name>", Color3.fromRGB(255,200,0)) return true
        elseif cmd=="/memelist" then
            for i,s in ipairs(MEME_STICKERS) do
                addSystemMessage(i..". "..s.name.." - "..(s.id and s.id:sub(1,50) or ""), Color3.fromRGB(200,200,255))
            end
            return true
        elseif cmd=="/syncmemes" then
            H.runMemeSyncOnce(true)
            return true
        elseif cmd=="/stopmemessync" or cmd=="/stopsyncmemes" then
            H.stopMemeSync()
            addSystemMessage("Meme sync stopped", Color3.fromRGB(255,200,100))
            return true
        elseif cmd=="/reloadmemes" then
            invalidateMemeListCache()
            H.loadCustomStickers() H.refreshStickers() addSystemMessage("Reloaded "..#MEME_STICKERS.." memes", Color3.fromRGB(100,255,100)) return true
        elseif cmd=="/clearmemes" then
            if (myRole~="owner" and myRole~="author") then
                addSystemMessage("🚫 Unauthorized command: /clearmemes (owner only)", Color3.fromRGB(255,80,80))
                return true
            end
            httpPut(STICKERS_ROOT..".json","{}") httpPut(SYNCED_MEMES_ROOT..".json","{}")
            MEME_STICKERS = {{name="MY_MEME", id="rbxassetid://85535407882603"}, {name="ASSET_123177152458601", id="rbxassetid://123177152458601"}}
            syncedHashes = {}
            for _,b in pairs(drawnStickerKeys) do if b.Parent then b:Destroy() end end
            drawnStickerKeys = {}
            H.refreshStickers()
            return true
        elseif cmd=="/deleteallmemes" then
            if (myRole~="owner" and myRole~="author") then
                addSystemMessage("🚫 Unauthorized command: /deleteallmemes (owner only)", Color3.fromRGB(255,80,80))
                return true
            end
            H.deleteAllServerMemes()
            return true
        elseif cmd=="/dedupemusic" then
            task.spawn(function()
                local n = MX.dedupe and MX.dedupe(true) or 0
                addSystemMessage("🧹 rx_music: "..n.." duplicate local file(s) removed", PAL.SUCCESS)
                if myRole=="owner" or myRole=="author" then
                    local r = MX.cleanFirebase and MX.cleanFirebase()
                    if r == nil then
                        addSystemMessage("Firebase cleanup skipped (could not read rx_music, check rules).", PAL.DANGER)
                    else
                        addSystemMessage("🧹 Firebase rx_music: "..r.." orphan entr"..(r==1 and "y" or "ies").." removed", PAL.SUCCESS)
                    end
                else
                    addSystemMessage("Firebase cleanup is owner-only.", PAL.ACCENT_2)
                end
                if MX.refresh then MX.refresh() end
            end)
            return true
        elseif cmd=="/deleteallmusic" or cmd=="/clearmusic" then
            if (myRole~="owner" and myRole~="author") then
                addSystemMessage("🚫 Unauthorized command: /deleteallmusic (owner only)", Color3.fromRGB(255,80,80))
                return true
            end
            task.spawn(function()
                -- true = node empty, false = still has data, nil = could not read it
                local function isEmpty(root)
                    local resp = httpGetFresh(root..".json?shallow=true")
                    if resp == nil then return nil end
                    local t = tostring(resp):gsub("%s+","")
                    if t=="null" or t=="{}" then return true end
                    if t:find('"error"',1,true) then return nil end
                    return false
                end
                local function wipe()
                    httpPut(MX.root..".json","{}")
                    httpPut(MX.index..".json","{}")
                end
                wipe()
                local e1, e2 = isEmpty(MX.root), isEmpty(MX.index)
                if e1==false or e2==false then
                    task.wait(0.5)
                    wipe()
                    e1, e2 = isEmpty(MX.root), isEmpty(MX.index)
                end
                if e1==true and e2==true then
                    addSystemMessage("All server music deleted from Firebase\n(verified empty).\nLocal rx_music files were kept.", PAL.ACCENT_2)
                elseif e1==false or e2==false then
                    addSystemMessage("Delete sent but Firebase still has music (check database rules).", PAL.DANGER)
                else
                    addSystemMessage("Delete sent but could not verify Firebase is empty. Press the music refresh button to check.", PAL.ACCENT_2)
                end
                if MX.refresh then MX.refresh() end
            end)
            return true
        elseif cmd=="/showblockedusers" then
            showBlockedUsersWindow()
            return true
        elseif cmd=="/help" then
            local helpCommands={"/clear","/clearall","/addmeme","/addmemeurl","/syncmemes","/stopmemessync","/stopsyncmemes","/reloadmemes","/memelist","/showblockedusers","/dedupemusic","/help"}
            if myRole=="owner" or myRole=="author" then
                table.insert(helpCommands, "/deleteallmemes")
                table.insert(helpCommands, "/deleteallmusic")
                table.insert(helpCommands, "/clearmusic")
            end
            addSystemMessage(table.concat(helpCommands,"\n"))
            return true
        end
        return false
    end

