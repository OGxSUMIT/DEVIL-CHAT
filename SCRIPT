    -- Fetch messages
    local lastMsgKey=nil
    function H.fetchNewMessagesUnsafe()
        local fetchUrl=MESSAGE_FETCH_URL
        if lastMsgKey then fetchUrl=fetchUrl.."&startAt=%22"..HttpService:UrlEncode(lastMsgKey).."%22" end
        local resp=httpGetFresh(fetchUrl)
        if not resp or tostring(resp):find('"error"',1,true) then return end
        local data=jsonDecode(resp)
        if type(data)~="table" or data.error then return end
        local maxTs=lastTimestamp
        for entryKey,entry in pairs(data) do
            if type(entryKey)=="string" and entryKey:match("^%-[%w_%-]+$") and (not lastMsgKey or entryKey>lastMsgKey) then lastMsgKey=entryKey end
            local isJoinShape=type(entry)=="table" and entry.system==true and entry.event=="join"
            if type(entry)=="table" and (entry.rx==1 or isJoinShape) then
                local ts=tonumber(entry.timestamp) or 0
                if ts>0 and ts<100000000000 then ts=ts*1000 end
                local name=entry.name
                local displayName=entry.displayName or entry.name
                local msg=entry.message
                local to=entry.to
                local isJoinEvent=isJoinShape
                local eventName=name or (isJoinEvent and displayName) or (isJoinEvent and entry.userId and tostring(entry.userId))
                local id=entry.id or ((eventName or entry.userId or "")..":"..ts..":"..(msg or entry.event or ""))
                if entry.isMusic or entry.musicAssetId then
                    seenIds[id]=true
                    if ts>maxTs then maxTs=ts end
                elseif seenIds[id] then
                    if ts>maxTs then maxTs=ts end
                else
                    local allowed=true
                    if to and to~="" then
                        local toString=tostring(to)
                        local isForMe=(toString==tostring(player.UserId) or toString==tostring(player.Name))
                        local isFromMe=(tostring(name)==tostring(player.Name))
                        if not isForMe and not isFromMe then allowed=false end
                    end
                    if eventName and (msg or isJoinEvent) and allowed and
                        ((isJoinEvent and tostring(entry.userId or eventName)~=tostring(player.UserId)) or
                        (not isJoinEvent and name~=player.Name)) and
                        not blockedUsers[eventName] then
                        if isJoinEvent or not H.isContentDuplicate(entry.userId or eventName, msg) then
                            local isFreshJoin=isJoinEvent and (ts==0 or ts>=SESSION_STARTED_AT)
                            if ts<SESSION_CUTOFF then
                                seenIds[id]=true
                            elseif isFreshJoin or ts>=lastTimestamp-86400000 then
                                seenIds[id]=true
                                local senderBlocked=entry.userId and globalBlocks[tostring(entry.userId)] and true or false
                                if not senderBlocked then
                                    if entry.system then
                                        if entry.event=="clearall" then
                                            for _,child in pairs(scroller:GetChildren()) do
                                                if (child:IsA("TextLabel") or child:IsA("Frame")) and child.Name~="BottomSpacer" then child:Destroy() end
                                            end
                                            messageQueue={} trackedHeight=0
                                            addSystemMessage("Chat cleared by "..(entry.by or "staff"), PAL.ACCENT_2)
                                        elseif entry.event=="join" then
                                            local joinedName=tostring(entry.displayName or displayName or eventName or "Unknown")
                                            local joinShown=false
                                            pcall(function() joinShown=(H.showUnifiedJoin(eventName, joinedName, entry.userId or 0)==true) end)
                                            if joinShown then
                                                local jr=resolveRole(entry.role, entry.userId)
                                                local jText=tostring(msg or (joinedName.." joined DEVIL CHAT"))
                                                local jColor=(jr=="owner" or jr=="author") and Color3.fromRGB(255,215,0) or Color3.fromRGB(80,230,255)
                                                pcall(function() addSystemMessage(jText, jColor) end)
                                            end
                                        else
                                            addSystemMessage(msg, PAL.ACCENT_2)
                                        end
                                    else
                                        local isStickerMsg=msg and msg:find("%[STICKER%]") and true or false
                                        local replyData=nil
                                        if entry.replySender and entry.replySender~="" then
                                            replyData={sender=entry.replySender, text=entry.replyText or entry.replySender}
                                        end
                                        if isStickerMsg then
                                            local msgRole=entry.role or "none"
                                            local msgUserId=entry.userId
                                            local hash=entry.sticker_hash
                                            local stickerId=entry.sticker
                                            if hash and hash~="" then
                                                local foundLocalId=nil
                                                for _,s in ipairs(MEME_STICKERS) do
                                                    if s.hash==hash and s.id and s.id~="" then foundLocalId=s.id break end
                                                end
                                                addChatMessage(displayName, msg, false, msgRole, msgUserId, to, foundLocalId or "", replyData, hash, name)
                                                H.showToast(name, getNick(msgUserId or 0, displayName), msg, H.avatarFallback(msgUserId), false, {userId=msgUserId, role=msgRole, private=(to and to~="") and true or false, sticker=true, reply=replyData~=nil})
                                            elseif stickerId and stickerId~="" then
                                                addChatMessage(displayName, msg, false, msgRole, msgUserId, to, stickerId, replyData, nil, name)
                                                H.showToast(name, getNick(msgUserId or 0, displayName), msg, H.avatarFallback(msgUserId), false, {userId=msgUserId, role=msgRole, private=(to and to~="") and true or false, sticker=true, reply=replyData~=nil})
                                            end
                                        else
                                            addChatMessage(displayName, msg, false, entry.role or "none", entry.userId, to, entry.sticker, replyData, entry.sticker_hash, name)
                                            H.showToast(name, getNick(entry.userId or 0, displayName), msg, H.avatarFallback(entry.userId), false, {userId=entry.userId, role=entry.role, private=(to and to~="") and true or false, reply=replyData~=nil})
                                            local otherPlayer=Players:FindFirstChild(name)
                                            if otherPlayer and otherPlayer.Character then H.makeBubble(otherPlayer.Character, msg) end
                                        end
                                    end
                                end
                            else seenIds[id]=true end
                            if ts>maxTs then maxTs=ts end
                        end
                    end
                end
            end
        end
        lastTimestamp=maxTs
    end

    local fetchInProgress=false
    local lastFetchStarted=0
    function H.fetchNewMessages()
        local now=os.clock()
        if fetchInProgress or now-lastFetchStarted<MIN_FETCH_GAP then return end
        fetchInProgress=true lastFetchStarted=now
        local ok,err=pcall(H.fetchNewMessagesUnsafe)
        fetchInProgress=false
        if not ok then warn("[DEVIL] fetch: "..tostring(err)) end
    end

    -- BLOCKED USERS WINDOW
    local blockedUsersWindow, blockedUsersScroller
    function H.refreshBlockedUsersWindow()
        if not blockedUsersWindow or not blockedUsersWindow.Parent then return end
        pcall(function() H.fetchGlobalBlocks(true) end)
        for _,child in ipairs(blockedUsersScroller:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
        end
        local presenceData={}
        pcall(function() presenceData=jsonDecode(httpGetFresh(PRESENCE_URL) or "{}") end)
        local rows={}
        for uid,entry in pairs(globalBlocks) do
            if type(entry)=="table" and tonumber(uid) then
                local pe=type(presenceData)=="table" and presenceData[tostring(uid)] or nil
                local rrole=entry.role or (pe and pe.role) or resolveRole(nil,uid)
                local dn=(pe and pe.displayName) or entry.displayName
                if not dn or dn=="" then
                    local op=Players:GetPlayerByUserId(tonumber(uid))
                    if op then dn=op.DisplayName end
                end
                rows[#rows+1]={uid=tostring(uid),name=getNick(uid, dn or ("User "..tostring(uid))),role=rrole,entry=entry}
            end
        end
        table.sort(rows,function(x,y) return tostring(x.name):lower()<tostring(y.name):lower() end)
        if #rows==0 then
            local empty=Instance.new("TextLabel")
            empty.Size=UDim2.new(1,-10,0,36)
            empty.BackgroundTransparency=1 empty.Text="No users blocked this session"
            empty.TextColor3=PAL.TEXT_DIM empty.TextSize=11
            empty.Font=Enum.Font.Gotham empty.ZIndex=202 empty.Parent=blockedUsersScroller
        else
            for index,row in ipairs(rows) do
                local holder=Instance.new("Frame")
                holder.Size=UDim2.new(1,-8,0,42)
                holder.BackgroundColor3=PAL.PANEL_SOFT holder.BorderSizePixel=0
                holder.LayoutOrder=index holder.ZIndex=202 holder.Parent=blockedUsersScroller
                task.delay(index*0.04, function() if holder.Parent then H.fadeIn(holder, 0.3) end end)
                do local rc=Instance.new("UICorner") rc.CornerRadius=UDim.new(0,6) rc.Parent=holder end
                local avatar=Instance.new("ImageLabel")
                avatar.Size=UDim2.new(0,32,0,32) avatar.Position=UDim2.new(0,5,0,5)
                avatar.BackgroundTransparency=1 avatar.Image=H.avatarFallback(row.uid)
                avatar.ZIndex=203 avatar.Parent=holder
                pcall(function() H.loadAvatarInto(avatar,row.uid,row.name) end)
                local nameLbl=Instance.new("TextLabel")
                nameLbl.Size=UDim2.new(1,-116,1,0) nameLbl.Position=UDim2.new(0,44,0,0)
                nameLbl.BackgroundTransparency=1 nameLbl.Text=tostring(row.name)
                nameLbl.TextColor3=getOnlineColor(row.role,row.uid)
                nameLbl.TextSize=11 nameLbl.Font=Enum.Font.GothamBold
                nameLbl.TextXAlignment=Enum.TextXAlignment.Left nameLbl.ZIndex=203 nameLbl.Parent=holder
                local uBtn=Instance.new("TextButton")
                uBtn.Size=UDim2.new(0,66,0,28) uBtn.Position=UDim2.new(1,-72,0.5,-14)
                uBtn.BackgroundColor3=PAL.ACCENT uBtn.Text="Unblock"
                uBtn.TextColor3=Color3.fromRGB(255,255,255) uBtn.TextSize=10
                uBtn.Font=Enum.Font.GothamBold uBtn.ZIndex=203 uBtn.Parent=holder
                do local uc=Instance.new("UICorner") uc.CornerRadius=UDim.new(0,5) uc.Parent=uBtn end
                uBtn.MouseButton1Click:Connect(function()
                    local targetId=tonumber(row.uid)
                    local targetRole=row.role or resolveRole(row.entry.role,targetId)
                    if not canModerate(targetRole,targetId) then
                        addSystemMessage("You cannot unblock this user.", PAL.DANGER)
                        return
                    end
                    local blockPath=BLOCKS_ROOT.."/"..row.uid..".json"
                    local controlPath=CONTROLS_ROOT.."/"..row.uid..".json"
                    pcall(function() httpDelete(blockPath) end)
                    pcall(function() httpDelete(controlPath) end)
                    task.wait(0.2)
                    H.fetchGlobalBlocks(true)
                    if globalBlocks[row.uid] then
                        pcall(function() httpDelete(blockPath) end)
                        pcall(function() httpDelete(controlPath) end)
                        task.wait(0.2)
                        H.fetchGlobalBlocks(true)
                    end
                    if globalBlocks[row.uid] then
                        addSystemMessage("Could not unblock "..tostring(row.name)..". Try again.", PAL.DANGER)
                    else
                        blockedUsers[row.name]=nil
                        pcall(function() H.broadcastModerationNotice("UNBLOCKED",row.name,targetId) end)
                    end
                    H.refreshBlockedUsersWindow()
                end)
            end
        end
        blockedUsersScroller.CanvasSize=UDim2.new(0,0,0,math.max(46,#rows*45+5))
    end
    showBlockedUsersWindow=function()
        if (ROLE_LEVELS[myRole] or 0)<2 then
            addSystemMessage("🚫 Unauthorized", PAL.DANGER) return
        end
        if blockedUsersWindow and blockedUsersWindow.Parent then
            blockedUsersWindow.Visible=true H.refreshBlockedUsersWindow() H.popIn(blockedUsersWindow, 0.88, 0.3) return
        end
        blockedUsersWindow=Instance.new("Frame")
        blockedUsersWindow.Size=UDim2.new(0,340,0,280)
        blockedUsersWindow.Position=UDim2.new(0.5,-170,0.5,-140)
        blockedUsersWindow.BackgroundColor3=PAL.BG blockedUsersWindow.BorderSizePixel=0
        blockedUsersWindow.ZIndex=200 blockedUsersWindow.Parent=sg
        local bc=Instance.new("UICorner") bc.CornerRadius=UDim.new(0,12) bc.Parent=blockedUsersWindow
        local bs=Instance.new("UIStroke") bs.Color=PAL.BORDER bs.Thickness=2 bs.Parent=blockedUsersWindow
        local titleBar=Instance.new("Frame")
        titleBar.Size=UDim2.new(1,0,0,30) titleBar.BackgroundColor3=Color3.fromRGB(0,0,0)
        titleBar.BackgroundTransparency=0.35 titleBar.BorderSizePixel=0 titleBar.Active=true
        titleBar.ZIndex=201 titleBar.Parent=blockedUsersWindow
        local tbc=Instance.new("UICorner") tbc.CornerRadius=UDim.new(0,12) tbc.Parent=titleBar
        local title=Instance.new("TextLabel")
        title.Size=UDim2.new(1,-38,1,0) title.Position=UDim2.new(0,12,0,0)
        title.BackgroundTransparency=1 title.Text="😈 Blocked Users"
        title.TextColor3=PAL.ACCENT_2 title.TextSize=12
        title.Font=Enum.Font.GothamBlack title.TextXAlignment=Enum.TextXAlignment.Left
        title.ZIndex=202 title.Parent=titleBar
        local close=Instance.new("TextButton")
        close.Size=UDim2.new(0,30,0,30) close.Position=UDim2.new(1,-30,0,0)
        close.BackgroundTransparency=1 close.Text="X" close.TextColor3=PAL.DANGER
        close.TextSize=14 close.Font=Enum.Font.GothamBold close.ZIndex=202 close.Parent=titleBar
        close.MouseButton1Click:Connect(function() H.popOut(blockedUsersWindow) end)
        makeDraggable(titleBar, {close}, blockedUsersWindow)
        blockedUsersScroller=Instance.new("ScrollingFrame")
        blockedUsersScroller.Size=UDim2.new(1,-10,1,-40) blockedUsersScroller.Position=UDim2.new(0,5,0,36)
        blockedUsersScroller.BackgroundColor3=PAL.PANEL blockedUsersScroller.BorderSizePixel=0
        blockedUsersScroller.ScrollBarThickness=4 blockedUsersScroller.ScrollBarImageColor3=PAL.ACCENT
        blockedUsersScroller.CanvasSize=UDim2.new(0,0,0,0) blockedUsersScroller.ZIndex=201
        blockedUsersScroller.Parent=blockedUsersWindow
        local blc=Instance.new("UICorner") blc.CornerRadius=UDim.new(0,8) blc.Parent=blockedUsersScroller
        local layout=Instance.new("UIListLayout")
        layout.SortOrder=Enum.SortOrder.LayoutOrder layout.Padding=UDim.new(0,3) layout.Parent=blockedUsersScroller
        H.refreshBlockedUsersWindow()
        H.popIn(blockedUsersWindow, 0.88, 0.3)
    end

    task.defer(function() H.popIn(frame, 0.85, 0.45) end)

    -- Startup messages
    addSystemMessage("Welcome to DEVIL CHAT, "..getNick(player.UserId, player.DisplayName).."!", PAL.ACCENT_2)
    addSystemMessage("/syncmemes to sync memes", PAL.SUCCESS)
    addSystemMessage("/stopsyncmemes to stop", PAL.SUCCESS)
    addSystemMessage("Use the 🎧 Music Player 🔄 button to sync rx_music", PAL.SUCCESS)
    addSystemMessage("/help for commands", PAL.SUCCESS)
    task.spawn(function()
        if alive then
            local welcomeAvatar=H.getAvatar(player.UserId)
            if alive then H.showWelcomeCard(getNick(player.UserId, player.DisplayName), welcomeAvatar) end
        end
    end)
    task.spawn(function()
        task.wait(3)
        if alive then
            local joinSlot=math.floor(os.time()/1800)
            local isOwnerSender=(myRole=="owner" or myRole=="author")
            local joinId="join_"..tostring(player.UserId).."_"..tostring(joinSlot)
            if isOwnerSender then joinId=joinId.."_"..tostring(os.time()).."_"..tostring(math.random(1000,9999)) end
            pcall(function()
                httpPost(FIREBASE_URL, jsonEncode({
                    name=player.Name,
                    displayName=player.DisplayName,
                    userId=player.UserId,
                    message=player.DisplayName.." joined Devil Chat",
                    timestamp={[".sv"]="timestamp"},
                    id=joinId,
                    role=myRole,
                    system=true,
                    event="join"
                }))
            end)
        end
    end)

    -- Presence heartbeat
    task.spawn(function()
        while alive do
            pcall(function()
                httpPut(PRESENCE_ROOT.."/"..tostring(player.UserId)..".json", jsonEncode({
                    name=player.Name, displayName=player.DisplayName, userId=player.UserId,
                    lastSeen={[".sv"]="timestamp"}, role=myRole
                }))
            end)
            task.wait(PRESENCE_INTERVAL)
        end
        pcall(function()
            local resp=httpGetFresh(MUSIC_PRESENCE_URL)
            local data=jsonDecode(resp or "{}")
            if data and tonumber(data.byUserId)==player.UserId then httpDelete(MUSIC_PRESENCE_URL) end
        end)
    end)

    -- Blocks poll
    task.spawn(function()
        while alive do
            pcall(function() H.fetchGlobalBlocks(false) end)
            if onlinePanel.Visible then pcall(function() refreshOnlineList(false) end) end
            task.wait(BLOCKS_INTERVAL)
        end
    end)

    -- Control poll (kick/block)
    task.spawn(function()
        while alive do
            pcall(function()
                local raw=httpGetFresh(CONTROL_URL)
                local control=jsonDecode(raw or "{}")
                local controlTime=tonumber(control.timestamp) or 0
                if control.action=="kick" and controlTime>=SESSION_STARTED_AT and not hasNotifiedKick then
                    hasNotifiedKick=true
                    addSystemMessage("You were kicked by "..tostring(control.by or "moderator"), PAL.DANGER)
                    task.wait(1)
                    pcall(function() httpDelete(PRESENCE_ROOT.."/"..tostring(player.UserId)..".json") end)
                    sg:Destroy()
                    return
                elseif control.action=="block" and controlTime>=SESSION_STARTED_AT then
                    unblockPending=true
                    if not hasNotifiedBlock then
                        blockedUsers["__ALL__"]=true
                        addSystemMessage("You have been blocked.", PAL.DANGER)
                        hasNotifiedBlock=true
                    else
                        blockedUsers["__ALL__"]=true
                    end
                else
                    if not globalBlocks[tostring(player.UserId)] and control.action~="block" then
                        if hasNotifiedBlock then
                            blockedUsers["__ALL__"]=nil
                            hasNotifiedBlock=false
                        end
                        if unblockPending then
                            unblockPending=false
                            blockedUsers["__ALL__"]=nil
                            addSystemMessage("You are unblocked! ✅", PAL.SUCCESS)
                        end
                    end
                end
            end)
            task.wait(CONTROL_INTERVAL)
        end
    end)

    -- Message poll
    task.spawn(function()
        while alive do
            task.wait(POLL_INTERVAL)
            H.safeRuntimeCall(H.fetchNewMessages)
        end
    end)

    H.addSystemLinkMessage("https://downloadrxchatapp.netlify.app/")
    addSystemMessage("😈 DEVIL CHAT CONNECTED 😈🔥", PAL.ACCENT_2)
    scrollToLatest()
    task.spawn(function()
        task.wait(0.15)
        if alive then H.safeRuntimeCall(H.fetchNewMessages) end
    end)
    task.spawn(function()
        task.wait(0.45)
        if alive then pcall(function() refreshOnlineList(false) end) end
    end)
    print("[DEVIL] buildUI() finished — V3.1 ready")
end

