    function H.showUnifiedJoin(name, displayName, userId)
        local joinedRole=resolveRole(nil, userId)
        local sessionKey=tostring(userId or "")~="" and ("id:"..tostring(userId)) or ("n:"..tostring(name or displayName or ""):lower())
        if sessionJoinSeen[sessionKey] then return false end
        sessionJoinSeen[sessionKey]=true
        local topRole=(joinedRole=="owner" or joinedRole=="author")
        if alive then pcall(function() H.showJoinCard(name, displayName, userId, topRole, joinedRole=="author" and "AUTHOR" or "OWNER") end) end

        if joinedRole=="owner" then
            H.enqueueToast(function() return H.showOwnerJoinToast(name, displayName, userId) end, true)
            return true
        end
        if joinedRole=="author" then
            H.enqueueToast(function() return H.showAuthorJoinToast(name, displayName, userId) end, true)
            return true
        end
        return true
    end

