local b64chars='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local function pureB64Encode(data)
    local r,len,i={},#data,1
    while i<=len do
        local a=string.byte(data,i) or 0 local b=string.byte(data,i+1) or 0 local c=string.byte(data,i+2) or 0
        local n=a*65536+b*256+c
        table.insert(r,b64chars:sub(math.floor(n/262144)%64+1,math.floor(n/262144)%64+1))
        table.insert(r,b64chars:sub(math.floor(n/4096)%64+1,math.floor(n/4096)%64+1))
        if i+1>len then table.insert(r,'=') table.insert(r,'=')
        elseif i+2>len then table.insert(r,b64chars:sub(math.floor(n/64)%64+1,math.floor(n/64)%64+1)) table.insert(r,'=')
        else
            table.insert(r,b64chars:sub(math.floor(n/64)%64+1,math.floor(n/64)%64+1))
            table.insert(r,b64chars:sub(n%64+1,n%64+1))
        end
        i=i+3
    end
    return table.concat(r)
end
local function pureB64Decode(data)
    data=data:gsub('[^'..b64chars..'=]','')
    local r,i={},1
    while i<=#data do
        local c1=(b64chars:find(data:sub(i,i)) or 1)-1
        local c2=(b64chars:find(data:sub(i+1,i+1)) or 1)-1
        local c3=(b64chars:find(data:sub(i+2,i+2)) or 1)-1
        local c4=(b64chars:find(data:sub(i+3,i+3)) or 1)-1
        local n=c1*262144+c2*4096+c3*64+c4
        table.insert(r,string.char(math.floor(n/65536)%256))
        if data:sub(i+2,i+2)~='=' then table.insert(r,string.char(math.floor(n/256)%256)) end
        if data:sub(i+3,i+3)~='=' then table.insert(r,string.char(n%256)) end
        i=i+4
    end
    return table.concat(r)
end
local function b64Encode(data)
    if not data then return nil end
    if type(base64)=="table" and type(base64.encode)=="function" then local ok,r=pcall(function() return base64.encode(data) end) if ok and r~="" then return r end end
    if type(syn)=="table" and type(syn.crypt)=="table" and type(syn.crypt.base64)=="table" and type(syn.crypt.base64.encode)=="function" then local ok,r=pcall(function() return syn.crypt.base64.encode(data) end) if ok and r~="" then return r end end
