    function H.hasStickerByHashOrId(hash, id)
        if hash and hash~="" then for _,s in ipairs(MEME_STICKERS) do if s.hash==hash then return true end end end
        if id and id~="" then for _,s in ipairs(MEME_STICKERS) do if s.id==id then return true end end end
        return false
    end
    function H.hasStickerHash(hash)
        if not hash or hash=="" then return false end
        for _,s in ipairs(MEME_STICKERS) do if s.hash==hash then return true end end
        return false
    end

    function H.dedupStickers()
        local seenH, seenI, out = {}, {}, {}
        for _,s in ipairs(MEME_STICKERS) do
            local h = s.hash or ""
            local id = s.id or ""
            if isUsableMemeAsset(id) and not ((h~="" and seenH[h]) or (id~="" and seenI[id])) then
                if h~="" then seenH[h]=true end
                if id~="" then seenI[id]=true end
                table.insert(out, s)
            end
        end
        MEME_STICKERS = out
    end

    fileExistsForHash = function(hash)
        if not hash or hash=="" then return nil end
        for _,fp in ipairs(listMemeFiles()) do
            if tostring(fp):find(hash,1,true) then return fp end
        end
        return nil
    end

