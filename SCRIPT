    -- Speech bubble
    local activeBubbles={}
    local textSizeMemo={}
    function H.memoTextSize(text, size, font, maxW)
        local key=text.."\0"..tostring(size).."\0"..tostring(maxW)
        local v=textSizeMemo[key] if v then return v end
        local ok,bounds=pcall(function() return TextService:GetTextSize(text, size, font, Vector2.new(maxW, 1000)) end)
        if ok and bounds then textSizeMemo[key]=bounds return bounds end
        return nil
    end
    function H.makeBubble(char, msg)
        if not char or not char:FindFirstChild("Head") then return end
        local previous=activeBubbles[char]
        if previous and previous.Parent then previous:Destroy() end
        local display=sanitizeUtf8(msg)
        if display:find("%[STICKER%]") then display="📷 Sticker" end
        if display:gsub("%s","")=="" then display="." end
        local maxChars=80
        local okLen,charLen=pcall(function() return utf8.len(display) end)
        if okLen and charLen and charLen>maxChars then display=utf8TruncateEnd(display, maxChars) end
        local font=Enum.Font.GothamBold local textSize=13
        local maxW,minW=200,51
        local PADX,PADY=14,12
        -- measure the FULL text (not just the first chars) so the frame always fits it
        local w,h
        local b1=H.memoTextSize(display, textSize, font, maxW-PADX*2)
        if b1 then
            w=math.clamp(math.ceil(b1.X)+PADX*2+4, minW, maxW)
            local b2=H.memoTextSize(display, textSize, font, w-PADX*2) or b1
            h=math.clamp(math.ceil(b2.Y)+PADY*2, 30, 140)
        else
            w=maxW
            h=math.clamp(math.ceil(#display/22)*(textSize+3)+PADY*2, 30, 140)
        end
        local bill=Instance.new("BillboardGui")
        bill.Size=UDim2.new(0,w,0,h) bill.StudsOffset=Vector3.new(0,3.7,0)
        bill.AlwaysOnTop=true bill.Adornee=char.Head bill.Parent=sg
        bill.ClipsDescendants=false
        activeBubbles[char]=bill
        local bg=Instance.new("Frame")
        bg.Size=UDim2.new(1,0,1,0) bg.BackgroundColor3=PAL.BG
        bg.BackgroundTransparency=0.05 bg.BorderSizePixel=0 bg.Parent=bill
        local corner=Instance.new("UICorner") corner.CornerRadius=UDim.new(0,11) corner.Parent=bg
        local bgStroke=Instance.new("UIStroke") bgStroke.Color=PAL.BORDER bgStroke.Thickness=2 bgStroke.Parent=bg
        local txt=Instance.new("TextLabel")
        txt.AnchorPoint=Vector2.new(0.5,0.5) txt.Position=UDim2.new(0.5,0,0.5,0)
        txt.Size=UDim2.new(1,-PADX*2,1,-PADY*2) txt.BackgroundTransparency=1
        txt.TextColor3=PAL.TEXT txt.TextSize=textSize
        txt.Font=font txt.TextWrapped=true txt.ClipsDescendants=true
        txt.TextTruncate=Enum.TextTruncate.AtEnd
        txt.TextXAlignment=Enum.TextXAlignment.Center
        txt.TextYAlignment=Enum.TextYAlignment.Center
        txt.Text=display txt.Parent=bg
        bg.AnchorPoint=Vector2.new(0.5,1) bg.Position=UDim2.new(0.5,0,1,0)
        local bubbleScale=Instance.new("UIScale") bubbleScale.Scale=0.3 bubbleScale.Parent=bg
        H.tween(bubbleScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1})
        task.delay(3.6, function()
            if bill and bill.Parent then
                local fo=TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                H.tween(bubbleScale, fo, {Scale=0.6})
                H.tween(bg, fo, {BackgroundTransparency=1})
                H.tween(txt, fo, {TextTransparency=1})
                H.tween(bgStroke, fo, {Transparency=1})
            end
        end)
        task.delay(4, function()
            if activeBubbles[char]==bill then activeBubbles[char]=nil end
            if bill and bill.Parent then bill:Destroy() end
        end)
    end

