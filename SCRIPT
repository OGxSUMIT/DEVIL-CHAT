        if clean=="" or clean=="0" then
            addSystemMessage("Invalid asset ID", PAL.DANGER) return nil
        end
        if isServerActive and mType=="client" then
            addSystemMessage("🔇 Server active! Stop server first.", PAL.DANGER) return nil
        end
        stopAllMusicSafe(mType=="server")
        local s=nil
        local ok=pcall(function()
            s=Instance.new("Sound") s.Name="RX_Music" s.SoundId="rbxassetid://"..clean
            s.Volume=1 s.Looped=false s.Parent=workspace s:Play()
        end)
        if not ok or not s then
            if s then pcall(function() s:Destroy() end) end
            addSystemMessage("Audio "..clean.." failed", PAL.DANGER) return nil
        end
        currentSound=s currentMusicType=mType
        if mType=="server" then isServerActive=true else isServerActive=false end
        s.Ended:Connect(function()
            pcall(function()
                if currentSound==s then
                    currentSound=nil currentMusicType=nil
                    if mType=="server" then isServerActive=false end
                end
            end)
        end)
        return s
    end

