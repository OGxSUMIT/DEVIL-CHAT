        if loadBar and loadBar.Parent then loadBar.Size=UDim2.new(i,0,1,0) end
        if loadStatus and loadStatus.Parent then
            if i<0.35 then loadStatus.Text="Summoning…"
            elseif i<0.75 then loadStatus.Text="Igniting…"
            else loadStatus.Text="Rising…" end
        end
        task.wait(0.02)
    end
    if running and sg.Parent then
        local ok,err=xpcall(buildUI, function(e)
            local tb=debug and debug.traceback and debug.traceback(tostring(e), 2)
            return tb or tostring(e)
        end)
        if not ok then
            warn("[DEVIL] buildUI error:\n"..tostring(err))
            if loadFrame and loadFrame.Parent then loadStatus.Text="Error" end
