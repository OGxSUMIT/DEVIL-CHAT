    -- AVATAR SYSTEM
    function H.avatarFallback(userId)
        local uid=tonumber(userId) or 0
        if uid<=0 then return "" end
        return "rbxthumb://type=AvatarHeadShot&id="..tostring(uid).."&w=100&h=100"
    end
    local avatarUserIdCache,avatarImageCache={},{}
    local avatarPending,avatarActiveRequests,avatarQueue={},0,{}
    function H.processAvatarQueue()
        while avatarActiveRequests<AVATAR_CONCURRENCY and #avatarQueue>0 do
            local job=table.remove(avatarQueue,1)
            avatarActiveRequests=avatarActiveRequests+1
            task.spawn(function()
                local uid=job.uid local content=nil
                for _=1,2 do
                    local ok,res=pcall(function() return Players:GetUserThumbnailAsync(uid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) end)
                    if ok and res and res~="" then content=res break end
                    task.wait(0.5)
                end
                if content then
                    avatarImageCache[uid]=content
                    if avatarPending[uid] then
                        for _,img in ipairs(avatarPending[uid]) do if img.Parent then img.Image=content end end
                        avatarPending[uid]=nil
                    end
                else avatarPending[uid]=nil end
                avatarActiveRequests=avatarActiveRequests-1
                H.processAvatarQueue()
            end)
        end
    end
    function H.resolveAvatarUserId(userId, username)
        local uid=tonumber(userId) or 0
        if uid>0 then return uid end
        local name=tostring(username or "") if name=="" then return 0 end
        local key=name:lower()
        if avatarUserIdCache[key] then return avatarUserIdCache[key] end
        local ok,resolved=pcall(function()
            if name==player.Name or name==player.DisplayName then return player.UserId end
            for _,pl in ipairs(Players:GetPlayers()) do
                if pl.Name==name or pl.DisplayName==name then return pl.UserId end
            end
            return Players:GetUserIdFromNameAsync(name)
        end)
        if ok and tonumber(resolved) and tonumber(resolved)>0 then
            avatarUserIdCache[key]=tonumber(resolved) return tonumber(resolved)
        end
        return 0
    end
    function H.getAvatar(userId, username)
        local uid=H.resolveAvatarUserId(userId, username)
        if uid<=0 then return "" end
        local cached=avatarImageCache[uid] if cached and cached~="" then return cached end
        local ok,content=pcall(function() return Players:GetUserThumbnailAsync(uid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) end)
        if ok and content and content~="" then avatarImageCache[uid]=content return content end
        return H.avatarFallback(uid)
    end
    function H.loadAvatarInto(imageLabel, userId, username)
        if not imageLabel then return end
        local uid=tonumber(userId) or 0
        if uid<=0 then uid=H.resolveAvatarUserId(userId, username) end
        if uid<=0 then imageLabel.Image="" return end
        local cached=avatarImageCache[uid] if cached and cached~="" then imageLabel.Image=cached return end
        imageLabel.Image=H.avatarFallback(uid)
        if avatarPending[uid] then table.insert(avatarPending[uid], imageLabel) return end
        avatarPending[uid]={imageLabel}
        table.insert(avatarQueue,{uid=uid})
        H.processAvatarQueue()
    end

